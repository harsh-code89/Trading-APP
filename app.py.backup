# Add additional imports for enhanced functionality
import time
import pickle
import os
from datetime import datetime, timedelta
import db

# Setup caching for stock data to avoid rate limits
DATA_CACHE_DIR = ".data_cache"
os.makedirs(DATA_CACHE_DIR, exist_ok=True)

# Initialize session state
if 'initialized' not in st.session_state:
    # Load portfolio data from database
    portfolio, cash, transaction_history = db.load_portfolio()
    
    st.session_state.portfolio = portfolio if portfolio is not None else {}
    st.session_state.cash = cash
    st.session_state.transaction_history = transaction_history
    st.session_state.last_ticker = 'AAPL'  # Last successfully loaded ticker
    st.session_state.data_cache = {}  # Cache for stock data
    st.session_state.initialized = True

# Function to get stock data with caching to avoid rate limits
def get_stock_data(ticker, start_date, end_date, days=5):
    """Get stock data with caching to avoid rate limits"""
    cache_key = f"{ticker}_{start_date.strftime('%Y%m%d')}_{end_date.strftime('%Y%m%d')}"
    cache_file = os.path.join(DATA_CACHE_DIR, f"{cache_key}.pkl")
    
    # Check if we have cached data that's not too old
    if os.path.exists(cache_file):
        file_modified_time = datetime.fromtimestamp(os.path.getmtime(cache_file))
        if datetime.now() - file_modified_time < timedelta(hours=24):  # Cache valid for 24 hours
            try:
                with open(cache_file, 'rb') as f:
                    return pickle.load(f), None
            except Exception as e:
                st.error(f"Error loading cached data: {str(e)}")
    
    # No valid cache, fetch from API with retry logic
    data, error = fetch_with_retry(ticker, start_date, end_date)
    
    # If successful, cache the results
    if data is not None and not data.empty and error is None:
        try:
            with open(cache_file, 'wb') as f:
                pickle.dump(data, f)
        except Exception as e:
            st.warning(f"Unable to cache data: {str(e)}")
    
    return data, error

# Function to try fetching with retry mechanism and rate limit prevention
def fetch_with_retry(ticker, start_date, end_date, max_retries=3, delay_seconds=2):
    """Try to fetch data with retries for rate limit errors"""
    # Add a mandatory delay before any API call to prevent rate limiting
    time.sleep(2)
    
    for attempt in range(max_retries):
        try:
            with st.spinner(f"Fetching data for {ticker}... Attempt {attempt+1}/{max_retries}"):
                try:
                    stock_data = yf.download(ticker, start=start_date, end=end_date, progress=False)
                    if not stock_data.empty:
                        return stock_data, None
                except Exception as yf_error:
                    # Handle Yahoo Finance specific errors
                    st.warning(f"Data not available right now, try later. (Attempt {attempt+1}/{max_retries})")
                    if "Rate limit" in str(yf_error):
                        st.info("Yahoo Finance rate limit reached. Please wait a moment before trying again.")
                    if attempt == max_retries - 1:
                        return None, ValueError("Data not available right now, try later.")
                
                # Wait between attempts
                time.sleep(delay_seconds)
        except Exception as fetch_error:
            if attempt < max_retries - 1:
                # Increase delay time for subsequent attempts (exponential backoff)
                time.sleep(delay_seconds * (attempt + 1))
            else:
                return None, ValueError("Data not available right now, try later.")
    
    return None, ValueError("Data not available right now, try later.")

# Function to calculate RSI
def calculate_rsi(data, window=14):
    # Calculate price changes
    delta = data.diff()
    
    # Get gains and losses
    gains = delta.copy()
    losses = delta.copy()
    gains[gains < 0] = 0
    losses[losses > 0] = 0
    losses = abs(losses)
    
    # Calculate average gains and losses
    avg_gain = gains.rolling(window=window).mean()
    avg_loss = losses.rolling(window=window).mean()
    
    # Calculate RS
    rs = avg_gain / avg_loss
    
    # Calculate RSI
    rsi = 100 - (100 / (1 + rs))
    
    return rsi

# Function to get trading recommendation based on RSI
def get_recommendation(rsi_value):
    if rsi_value < 30:
        return "Buy", "green"
    elif rsi_value > 70:
        return "Sell", "red"
    else:
        return "Hold", "gray"

# Function to execute a trade
def execute_trade(ticker, action, quantity, current_price):
    transaction_cost = quantity * current_price
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
    if action == "Buy":
        # Check if user has enough cash
        if transaction_cost > st.session_state.cash:
            return False, "Insufficient funds to complete purchase."
        
        # Update cash
        st.session_state.cash -= transaction_cost
        
        # Update portfolio
        if ticker in st.session_state.portfolio:
            # Calculate new average price
            current_shares = st.session_state.portfolio[ticker]['shares']
            current_avg_price = st.session_state.portfolio[ticker]['avg_price']
            total_shares = current_shares + quantity
            total_cost = (current_shares * current_avg_price) + transaction_cost
            new_avg_price = total_cost / total_shares
            
            st.session_state.portfolio[ticker]['shares'] = total_shares
            st.session_state.portfolio[ticker]['avg_price'] = new_avg_price
        else:
            st.session_state.portfolio[ticker] = {
                'shares': quantity,
                'avg_price': current_price
            }
        
        # Create transaction record
        transaction = {
            'timestamp': timestamp,
            'ticker': ticker,
            'action': action,
            'quantity': quantity,
            'price': current_price,
            'total': transaction_cost
        }
        
        # Record transaction in session state
        st.session_state.transaction_history.append(transaction)
        
        # Save to database
        db.save_portfolio(st.session_state.portfolio, st.session_state.cash, transaction)
        
        return True, f"Successfully purchased {quantity} shares of {ticker} for ${transaction_cost:.2f}"
    
    elif action == "Sell":
        # Check if user has enough shares
        if ticker not in st.session_state.portfolio or st.session_state.portfolio[ticker]['shares'] < quantity:
            return False, "Insufficient shares to complete sale."
        
        # Update cash
        st.session_state.cash += transaction_cost
        
        # Update portfolio
        st.session_state.portfolio[ticker]['shares'] -= quantity
        
        # If no shares left, remove from portfolio
        if st.session_state.portfolio[ticker]['shares'] == 0:
            del st.session_state.portfolio[ticker]
        
        # Create transaction record
        transaction = {
            'timestamp': timestamp,
            'ticker': ticker,
            'action': action,
            'quantity': quantity,
            'price': current_price,
            'total': transaction_cost
        }
        
        # Record transaction in session state
        st.session_state.transaction_history.append(transaction)
        
        # Save to database
        db.save_portfolio(st.session_state.portfolio, st.session_state.cash, transaction)
        
        return True, f"Successfully sold {quantity} shares of {ticker} for ${transaction_cost:.2f}"
    
    return False, "Invalid action specified."

# Function to reset the portfolio
def reset_portfolio():
    st.session_state.portfolio = {}
    st.session_state.cash = 10000.0
    st.session_state.transaction_history = []
    
    # Reset database portfolio
    db_reset_success = db.reset_db_portfolio()
    
    if not db_reset_success:
        return False, "Failed to reset portfolio in database."
    
    return True, "Portfolio has been reset to initial state."

