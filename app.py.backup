        st.subheader("RSI Indicator")
        
        fig_rsi = go.Figure()
        fig_rsi.add_trace(go.Scatter(x=data.index, y=data['RSI'], mode='lines', name='RSI', line=dict(color='#4D96FF', width=2)))
        
        # Add threshold lines with more descriptive annotations
        fig_rsi.add_hline(y=70, line_dash="dash", line_color="red", 
